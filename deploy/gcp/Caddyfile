{
    # Global options
    email {$ACME_EMAIL}
    # Log HTTP requests in structured format
    log {
        output stdout
        format console
    }
}

# ------------------------------------------------------------------------------
# Release / Production Slot (release/v* branches)
# ------------------------------------------------------------------------------
{$DOMAIN_RELEASE} {
    encode zstd gzip

    reverse_proxy microbin-release:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ------------------------------------------------------------------------------
# Preview Slot (main branch / preview deployments)
# ------------------------------------------------------------------------------
{$DOMAIN_PREVIEW} {
    encode zstd gzip

    reverse_proxy microbin-preview:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
